# Smart Investor Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration (Required)
# ===========================================
DB_NAME=smart_investor
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ===========================================
# DART OpenAPI (Required for Korean stocks)
# ===========================================
# Korean financial statements and dividends come from DART; neither pykrx nor
# FinanceDataReader exposes them. Without this key, Korean stocks collect
# prices only and cannot pass the fundamental criteria.
# Get a free key from: https://opendart.fss.or.kr/
DART_API_KEY=your_dart_api_key

# ===========================================
# Slack Notification (Optional)
# ===========================================
# Get token from: https://api.slack.com/apps
SLACK_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#smart-investor

# ===========================================
# Telegram Notification (Optional)
# ===========================================
# Get token from: @BotFather on Telegram
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your_chat_id

# ===========================================
# Email Notification (Optional)
# ===========================================
# For Gmail: use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=recipient1@email.com,recipient2@email.com
